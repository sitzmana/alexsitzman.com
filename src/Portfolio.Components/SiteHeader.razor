@* Navigation stays visible and wraps on small screens; no script-dependent menu. *@

<header class="masthead" id="top" tabindex="-1">
    <div class="shell masthead__shell">
        <a class="wordmark" href="/">
            <span class="wordmark__mark" aria-hidden="true">@Content.Site.Initials</span>
            <span class="visually-hidden">@Content.Site.Name — home</span>
        </a>

        <nav class="nav" aria-label="Primary">
            <ul class="nav__list">
                @foreach (var item in Content.NavPages)
                {
                    <li>
                        <a class="nav__link @(item.Route == CurrentRoute ? "is-current" : null)"
                           href="@item.Route"
                           aria-current="@(item.Route == CurrentRoute ? "page" : null)">
                            @item.NavLabel
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</header>

@code {
    [CascadingParameter]
    public required PortfolioContent Content { get; set; }

    [Parameter, EditorRequired]
    public required string CurrentRoute { get; set; }
}
