@* Small set of original geometric glyphs. Deliberately not third-party brand marks:
   links are labelled with text, so no trademarked artwork is needed. *@

<svg class="glyph @Class" viewBox="0 0 16 16" width="16" height="16" fill="none"
     stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
     stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "arrow-out":
            <path d="M6 3h7v7" />
            <path d="M13 3 3.5 12.5" />
            break;

        case "arrow-right":
            <path d="M3 8h10" />
            <path d="m9 4 4 4-4 4" />
            break;

        case "arrow-down":
            <path d="M8 3v10" />
            <path d="m4 9 4 4 4-4" />
            break;

        case "mail":
            <rect x="2" y="3.5" width="12" height="9" rx="1.5" />
            <path d="m2.5 5 5.5 4 5.5-4" />
            break;

        case "node":
            <circle cx="8" cy="8" r="2.25" />
            <path d="M8 1.5v4.25M8 10.25v4.25M1.5 8h4.25M10.25 8h4.25" />
            break;

        case "check":
            <path d="m3 8.5 3.5 3.5L13 5" />
            break;

        default:
            throw new ArgumentOutOfRangeException(nameof(Name), Name, "Unknown glyph.");
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public required string Name { get; set; }

    [Parameter]
    public string? Class { get; set; }
}
