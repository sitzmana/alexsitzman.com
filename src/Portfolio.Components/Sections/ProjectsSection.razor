<ContentSection Key="projects">
    <ol class="projects">
        @foreach (var (project, index) in Content.FeaturedProjects.Select((item, index) => (item, index + 1)))
        {
            <li class="project-entry reveal" id="project-@project.Slug" tabindex="-1" data-depth>
                <article class="card project-card depth-surface">
                    @if (project.Visual is not null)
                    {
                        <div class="project-card__art">
                            <p class="project-card__category">@project.Category</p>
                            <ProjectVisual Motif="@project.Visual" />
                            <p class="project-card__index" aria-hidden="true">@index.ToString("00", CultureInfo.InvariantCulture)</p>
                        </div>
                    }
                    <div class="card__body">
                        <p class="card__number">
                            <span>@index.ToString("00", CultureInfo.InvariantCulture)</span>
                            <span aria-hidden="true">/</span>
                            <span>@project.Category</span>
                        </p>
                        <h3 class="card__title">
                            @if (project.HasBody)
                            {
                                <a class="card__link" href="/projects/@project.Slug/">
                                    @project.Title
                                    <IconGlyph Name="arrow-right" Class="card__chevron" />
                                </a>
                            }
                            else if (project.Links.FirstOrDefault() is { } primaryLink)
                            {
                                <a class="card__link" href="@primaryLink.Url" rel="noopener noreferrer" target="_blank">
                                    @project.Title
                                    <IconGlyph Name="arrow-out" Class="card__chevron" />
                                    <span class="visually-hidden">(opens in a new tab)</span>
                                </a>
                            }
                            else
                            {
                                @project.Title
                            }
                        </h3>
                        @if (!string.IsNullOrWhiteSpace(project.Role) || !string.IsNullOrWhiteSpace(project.Period))
                        {
                            <p class="card__meta">
                                @if (!string.IsNullOrWhiteSpace(project.Role))
                                {
                                    <span>@project.Role</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(project.Period))
                                {
                                    <span>@project.Period</span>
                                }
                            </p>
                        }
                        @if (!string.IsNullOrWhiteSpace(project.Summary))
                        {
                            <p class="card__summary">@project.Summary</p>
                        }
                        <TagList Tags="project.Tags" Label="@($"Technologies used in {project.Title}")" />
                        <LinkList Links="project.Links" />
                    </div>
                </article>
            </li>
        }
    </ol>
</ContentSection>

@code {
    [CascadingParameter]
    public required PortfolioContent Content { get; set; }
}
