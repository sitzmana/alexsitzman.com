@* Technologies, grouped. No proficiency bars: a percentage on a skill is unverifiable. *@

<ContentSection Key="skills">
    <div class="skills">
        @foreach (var group in Content.Skills)
        {
            <section class="skills__group reveal">
                <h3 class="skills__heading">@group.Title</h3>
                <ul class="tags tags--lg">
                    @foreach (var item in group.Items)
                    {
                        <li class="tag">
                            @if (ExplorerRoute is { } route && LinkedTopics.Contains(item))
                            {
                                <a class="skill-link" href="@(route)?topic=@Uri.EscapeDataString(item)">
                                    @item <IconGlyph Name="arrow-right" />
                                </a>
                            }
                            else
                            {
                                @item
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    </div>
</ContentSection>

@code {
    [CascadingParameter]
    public required PortfolioContent Content { get; set; }

    private string? ExplorerRoute => Content.SectionRoute("explorer");
    private HashSet<string> LinkedTopics { get; set; } = new(StringComparer.OrdinalIgnoreCase);

    protected override void OnParametersSet() =>
        LinkedTopics = Content.Evidence.SelectMany(item => item.Topics).ToHashSet(StringComparer.OrdinalIgnoreCase);
}
