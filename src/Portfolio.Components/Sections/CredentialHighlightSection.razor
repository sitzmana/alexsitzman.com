<ContentSection Key="credential-highlight">
    @foreach (var credential in Content.Certifications.Where(item => item.Featured))
    {
        <article class="credential-highlight reveal">
            <div class="credential-highlight__seal" aria-hidden="true">
                <IconGlyph Name="node" />
            </div>
            <div class="credential-highlight__copy">
                <p class="credential-highlight__issuer">@credential.Issuer</p>
                <h3>@credential.Title</h3>
                @if (!string.IsNullOrWhiteSpace(credential.Summary))
                {
                    <p>@credential.Summary</p>
                }
                <TagList Tags="credential.Tags" Label="@($"Topics for {credential.Title}")" />
            </div>
        </article>
    }
    <div class="section-actions">
        @foreach (var link in Content.Site.Sections["credential-highlight"].Links)
        {
            <a class="button button--secondary" href="@link.Url">@link.Label <IconGlyph Name="arrow-right" /></a>
        }
    </div>
</ContentSection>

@code {
    [CascadingParameter]
    public required PortfolioContent Content { get; set; }
}
